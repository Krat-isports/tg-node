# Telegram bot token from @BotFather
BOT_TOKEN=

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Comma separated Telegram user ids with admin rights (optional)
ADMIN_IDS=

# --- HTTP health check endpoint --------------------------------------------
# Works with Vercel, Railway, Render, Fly.io, Koyeb, Docker, Kubernetes, etc.
# Many hosts set PORT — it is used as a fallback for HEALTH_PORT.
HEALTH_ENABLED=true
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000
# Interval for the Telegram reachability heartbeat used by /ready (ms)
HEALTH_HEARTBEAT_MS=30000
